# =============================================================================
# APEX INTELLIGENCE — ENVIRONMENT
# Copy to .env.local for development, and paste the same values into
# Vercel → Project → Settings → Environment Variables for production.
# .env.local is gitignored. Never commit real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# CONTACT FORM DELIVERY  ← the only thing you must configure
# -----------------------------------------------------------------------------
# Where enquiries land. Leave as is unless you want them elsewhere.
CONTACT_TO=info@apexintelligence.in

# Pick ONE of the three options below.


# --- OPTION 1: SMTP (recommended, and what this site uses) -------------------
# info@apexintelligence.in is on Hostinger (mail.hostinger.com), so mail goes
# out through that mailbox itself. No third-party service and NO app password —
# Hostinger accepts the normal mailbox password.
#
# Forgotten it? hPanel > Emails > Email Accounts > (...) > Change password.
#
# Port 465 is implicit SSL and is what Hostinger recommends. 587 with STARTTLS
# also works; the code picks the mode from the port number.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@apexintelligence.in
SMTP_PASS=your-mailbox-password

# Envelope sender. Must be an address this mailbox may send as — normally
# SMTP_USER. The visitor's address goes in Reply-To, never in From; putting
# them in From is what gets mail blocked by SPF and DMARC.
CONTACT_FROM="Apex Intelligence Website <info@apexintelligence.in>"

# If the mailbox ever moves, only the host and port change:
#   Google Workspace  smtp.gmail.com           587   (needs an app password)
#   Microsoft 365     smtp.office365.com       587   (needs an app password)
#   Zoho Mail         smtp.zoho.in             587
#   GoDaddy           smtpout.secureserver.net 587
#   cPanel / shared   mail.apexintelligence.in 465


# --- OPTION 2: Resend ---------------------------------------------------------
# Better deliverability once volume grows. Free for 3,000 emails a month.
# Requires verifying apexintelligence.in at resend.com/domains.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx


# --- OPTION 3: Webhook --------------------------------------------------------
# Forwards the raw JSON somewhere else — Zapier, Make, n8n, a CRM.
# No email is sent by the site itself; whatever receives it decides.
# CONTACT_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...


# -----------------------------------------------------------------------------
# SITE URL
# -----------------------------------------------------------------------------
# Canonical host for metadata, OpenGraph tags and the sitemap.
# Set this once the real domain is live.
NEXT_PUBLIC_SITE_URL=https://apexintelligence.in
